import {
  env,
  VisionEncoderDecoderModel,
  PreTrainedTokenizer,
  Tensor,
  cat
} from '@huggingface/transformers'
import sharp from 'sharp'

// 走站点同源代理下载模型（与线上 /ocr 完全一致的源）
env.remoteHost = 'https://snaplatex.cn'
env.remotePathTemplate = 'hf/{model}/resolve/{revision}'
env.allowLocalModels = false
env.allowRemoteModels = true
env.cacheDir = './.cache'

const MODEL = 'xzpdyy/pailishi-model'
const MEAN = 0.7931
const STD = 0.1738

// —— 复刻 imageProcessor.ts ——
function preprocessGray(grayArr, w, h) {
  // reverseColor：白底黑字不反转（深色主导才反转）——测试图全是白底，跳过
  // cropMargin：min-max 归一后 <200 的像素取 bbox
  let max = -Infinity
  let min = Infinity
  for (let i = 0; i < grayArr.length; i++) {
    if (grayArr[i] > max) max = grayArr[i]
    if (grayArr[i] < min) min = grayArr[i]
  }
  let minX = w, minY = h, maxX = 0, maxY = 0
  if (max !== min) {
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const idx = y * w + x
        const norm = ((grayArr[idx] - min) / (max - min)) * 255
        if (norm < 200) {
          if (x < minX) minX = x
          if (x > maxX) maxX = x
          if (y < minY) minY = y
          if (y > maxY) maxY = y
        }
      }
    }
  }
  let cw = maxX - minX
  let chh = maxY - minY
  if (maxX <= minX || maxY <= minY) { minX = 0; minY = 0; cw = w; chh = h }

  // resize：scale = 384 / min(边)
  const minDim = Math.min(384, 384)
  const scale = minDim / Math.min(chh, cw)
  let newW = Math.round(cw * scale)
  let newH = Math.round(chh * scale)
  if (newW > 384 || newH > 384) {
    const ratio = Math.min(384 / newW, 384 / newH)
    newW = Math.round(newW * ratio)
    newH = Math.round(newH * ratio)
  }

  // 从原图裁 bbox → 缩放（最近邻/Lanczos 差异可忽略）
  const cropped = Buffer.alloc(cw * chh)
  for (let y = 0; y < chh; y++) {
    for (let x = 0; x < cw; x++) {
      cropped[y * cw + x] = grayArr[(y + minY) * w + (x + minX)]
    }
  }
  const resized = sharp(cropped, { raw: { width: cw, height: chh, channels: 1 } })
    .resize(newW, newH)
    .raw()
    .toBuffer()

  // pad 黑色居中到 384×384 + normalize
  const out = new Float32Array(384 * 384)
  const padW = Math.floor((384 - newW) / 2)
  const padH = Math.floor((384 - newH) / 2)
  for (let y = 0; y < newH; y++) {
    for (let x = 0; x < newW; x++) {
      const v = resized[y * newW + x]
      out[(y + padH) * 384 + (x + padW)] = (v / 255.0 - MEAN) / STD
    }
  }
  return out
}

async function predict(pngPath) {
  const { data, info } = await sharp(pngPath).grayscale().raw().toBuffer({ resolveWithObject: true })
  const arr = preprocessGray(data, info.width, info.height)
  const tensor = new Tensor('float32', arr, [1, 1, 384, 384])
  const pixel_values = cat([tensor, tensor, tensor], 1)
  const outputs = await model.generate({ inputs: pixel_values })
  return tokenizer.batch_decode(outputs, { skip_special_tokens: true })[0]
}

console.log('loading model (first run downloads ~80MB via snaplatex.cn proxy)...')
const model = await VisionEncoderDecoderModel.from_pretrained(MODEL, { dtype: 'fp32' })
const tokenizer = await PreTrainedTokenizer.from_pretrained(MODEL)
console.log('model ready\n')

const cases = [
  ['f1_poly.png', 'x^{2} + 2x + 1 = 0'],
  ['f2_frac.png', '\\frac{1}{2}'],
  ['f3_sqrt.png', '\\sqrt{x + 1}'],
  ['f4_linear.png', 'y = kx + b'],
  ['f5_int.png', '\\int_{0}^{1} x^{2} dx']
]

for (const [file, truth] of cases) {
  try {
    const out = await predict(file)
    console.log(`[${file}]\n  真值: ${truth}\n  模型: ${out}\n`)
  } catch (e) {
    console.log(`[${file}] ERROR: ${e.message}\n`)
  }
}
